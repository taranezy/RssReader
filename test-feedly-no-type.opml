<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>Feedly Export - No Type Attributes</title>
  </head>
  <body>
    <!-- Folder WITHOUT type="folder" attribute -->
    <outline text="Scrum and Planning">
      <outline text="DZone" xmlUrl="https://feeds.dzone.com/home" />
      <outline text="Mike Cohn Blog" xmlUrl="https://www.mountaingoatsoftware.com/blog/feed" />
    </outline>
    <outline text="Entertainment">
      <outline text="YouTube Channel 1" xmlUrl="https://www.youtube.com/feeds/videos.xml?channel_id=UCxxxxx" />
    </outline>
    <!-- Standalone feed without folder -->
    <outline text="Standalone Feed" xmlUrl="https://example.com/feed.xml" />
  </body>
</opml>
