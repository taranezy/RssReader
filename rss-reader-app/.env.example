# Production Environment Configuration
# Copy this to .env and update with your production values

# Server Configuration
NODE_ENV=production
PORT=3000

# Session Secret - CHANGE THIS TO A RANDOM STRING!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-secure-random-string-in-production

# Google OAuth Configuration
# Get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# OAuth Callback URL - update to match your deployment
GOOGLE_CALLBACK_URL=https://streamlet.taranezy.com/streamlet/api/auth/google/callback

# Frontend URL - used for CORS configuration
# Note: Standard port 443 (no :8443) - host nginx proxies to backend
FRONTEND_URL=https://streamlet.taranezy.com/streamlet/

# Redis Configuration (currently disabled in docker-compose.yml)
# In production with Docker: redis
# For local development: localhost
REDIS_HOST=redis
REDIS_PORT=6379

# Database Configuration
# SQLite database persisted in Docker volume: rss-data:/app/backend/data
