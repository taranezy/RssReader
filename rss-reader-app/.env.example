# Production Environment Configuration
# Copy this to .env and update with your production values

# Server Configuration
NODE_ENV=production
PORT=3000

# Session Secret - CHANGE THIS TO A RANDOM STRING!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-secure-random-string-in-production

# Google OAuth Configuration
# Get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Update this URL to match your server
# For andromeda server: http://andromeda:3000/api/auth/google/callback
# For public domain: https://yourdomain.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Redis Configuration
# In production with Docker, use the service name 'redis' as the host
# Local development uses 'andromeda' or 'localhost'
REDIS_HOST=redis
REDIS_PORT=6379

# Frontend URL
# Used for CORS configuration
FRONTEND_URL=https://taranezy.ddns.net:8444

# Database Configuration
# SQLite database will be stored in backend/data/rss-reader.db
# In Docker, this is persisted via volume mount
