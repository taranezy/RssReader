# Multi-Site Environment Configuration
# Copy this to .env and fill in your values

# RSS Reader Configuration
FRONTEND_URL=https://streamlet.taranezy.com/
SESSION_SECRET=your-secret-key-change-in-production
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://streamlet.taranezy.com/api/auth/google/callback

# Nextcloud Configuration
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme
NEXTCLOUD_TRUSTED_DOMAINS=nextcloud.taranezy.com

# Vaultwarden Configuration
VAULTWARDEN_ADMIN_TOKEN=your-admin-token-here